OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_IN_DEVELOPMENT=false

# SMS OTP: NONE cho local, ESMS cho gui that. Brandname va noi dung phai duoc eSMS duyet.
SMS_PROVIDER=NONE
