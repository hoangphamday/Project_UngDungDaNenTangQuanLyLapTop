ESMS_API_URL=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2
ESMS_IS_UNICODE=0
ESMS_SANDBOX=true
ESMS_OTP_CONTENT={OTP} la ma xac minh dat lai mat khau Laptop Store cua ban

